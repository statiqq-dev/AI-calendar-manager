# Скопируй в .env: cp .env.example .env

# --- Модель ---
MODEL_NAME=qwen3:8b
MODEL_PROVIDER=ollama
MODEL_TEMPERATURE=0
# Для Claude: uv add langchain-anthropic, MODEL_PROVIDER=anthropic, MODEL_NAME=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- Календарь ---
# fake  — демо-календарь в памяти, работает везде, события пропадают после выхода
# macos — настоящий Календарь macOS (нужен доступ и отдельный календарь, см. README)
CALENDAR_BACKEND=fake
CALENDAR_NAME=AI Agent

# --- LangSmith (необязательно): трейсинг шагов агента в smith.langchain.com ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=calendar-agent
